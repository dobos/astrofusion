#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

source /opt/miniconda3/bin/activate astrofusion-2

cargo build --release
maturin build --release --strip --interpreter /opt/miniconda3/envs/astrofusion-2/bin/python

mkdir -p build/python
rm -rf build/python/*

wheel="$(ls -1 target/wheels/*.whl | tail -n 1)"
if [ -z "${wheel}" ]; then
  echo "No wheel produced by maturin" >&2
  exit 1
fi

unzip -o "$wheel" -d build/python

echo "Built importable Python package under ${ROOT}/build/python"
